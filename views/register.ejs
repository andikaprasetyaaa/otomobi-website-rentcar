<section class="row g-0 form-wrapper">
    <div class="col-4">
        <form action="" class="login-form">
            <h1 class="mb-3">Register</h1>
            <div class="mb-3">
                <label class="form-label">Full Name</label>
                <input name="fullname" id="fullname" type="fullname" class="form-control">
            </div>
            <div class="mb-3">
                <label class="form-label">Email</label>
                <input name="email" id="email" type="email" class="form-control">
            </div>
            <div class="mb-5">
                <label class="form-label">Password</label>
                <input name="password" id="password" type="password" class="form-control">
            </div>
            <div class="mb-5">
                <label class="form-label">Repeat Password</label>
                <input name="rpassword" id="rpassword" type="password" class="form-control">
            </div>
            <button class="btn btn-dark px-5">Register</button>
            <div class="mt-3">
                <span>Have an account? <a href="/login" class="text-decoration-none">Login</a></span>
            </div>
        </form>
    </div>
    <div class="col-8 form-img"></div>
</section>