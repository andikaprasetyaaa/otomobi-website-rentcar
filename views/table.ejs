<section>
    <header class="bg-dark py-5 ">
        <div class="container px-4 mt-5">
            <div class="text-center text-white">
                <h1 class="display-4 fw-bolder">Car Table</h1>
                <p>Lorem ipsum dolor, sit amet consectetur adipisicing elit.</p>
            </div>
        </div>
    </header>
    <section class="mt-5 p-5 row gx-5">
        <div class="col-lg-12 mb-5 ">
            <div class="row">
                <form action="/sortby-name" method="post" class="input-group mb-3 col">
                    <button type=" submit" class="btn btn-dark">Sort</button>

                    <select name="sortName" class="form-select" id="inputGroupSelect01">
                        <option selected>Name</option>
                        <option value="1">A-Z</option>
                        <option value="2">Z-A</option>
                    </select>
                </form>
                <form action="/sortby-price" method="post" class="input-group mb-3 col">
                    <button type=" submit" class="btn btn-dark">Sort</button>
                    <select name="sortPrice" class="form-select" id="inputGroupSelect01">
                        <option selected>Price</option>
                        <option value="1">Highest</option>
                        <option value="2">Lowest</option>
                    </select>
                </form>
                <form action="/sortby-year" method="post" class="input-group mb-3 col">
                    <button type=" submit" class="btn btn-dark">Sort</button>
                    <select name="sortYear" class="form-select" id="inputGroupSelect01">
                        <option selected>Year</option>
                        <option value="1">Latest</option>
                        <option value="2">Oldest</option>
                    </select>
                </form>
                <form action="/sortby-fuel" method="post" class="input-group mb-3 col">
                    <button type=" submit" class="btn btn-dark">Sort</button>
                    <select name="sortFuel" class="form-select" id="inputGroupSelect01">
                        <option selected>Fuel</option>
                        <% let fuelList=[] %>
                            <% cars.forEach((car)=> {%>
                                <% if (!fuelList.includes(car.fuel)) { %>
                                    <% fuelList.push(car.fuel); %>
                                        <option value='<%= car.fuel %>'>
                                            <%= car.fuel %>
                                        </option>
                                        <% } %>
                                            <% }) %>
                    </select>
                </form>
            </div>

            <!-- ROW 2 -->
            <div class="row">
                <form action="/sortby-make" method="post" class="input-group mb-3 col">
                    <button type=" submit" class="btn btn-dark">Sort</button>

                    <select name="sortMake" class="form-select" id="inputGroupSelect01">
                        <option selected>Make</option>
                        <% let makeList=[] %>
                            <% cars.forEach((car)=> {%>
                                <% if (!makeList.includes(car.make)) { %>
                                    <% makeList.push(car.make); %>
                                        <option value='<%= car.make %>'>
                                            <%= car.make %>
                                        </option>
                                        <% } %>
                                            <% }) %>

                    </select>
                </form>
                <form action="/sortby-color" method="post" class="input-group mb-3 col">
                    <button type=" submit" class="btn btn-dark">Sort</button>
                    <select name="sortColor" class="form-select" id="inputGroupSelect01">
                        <option selected>Color</option>
                        <% let colorList=[] %>
                            <% cars.forEach((car)=> {%>
                                <% if (!colorList.includes(car.color)) { %>
                                    <% colorList.push(car.color); %>
                                        <option value='<%= car.color %>'>
                                            <%= car.color %>
                                        </option>
                                        <% } %>
                                            <% }) %>
                    </select>
                </form>
                <form action="/sortby-transmission" method="post" class="input-group mb-3 col">
                    <button type=" submit" class="btn btn-dark">Sort</button>
                    <select name="sortTransmission" class="form-select" id="inputGroupSelect01">
                        <option selected>Transmission</option>
                        <% let transmissionList=[] %>
                            <% cars.forEach((car)=> {%>
                                <% if (!transmissionList.includes(car.transmission)) { %>
                                    <% transmissionList.push(car.transmission); %>
                                        <option value='<%= car.transmission %>'>
                                            <%= car.transmission %>
                                        </option>
                                        <% } %>
                                            <% }) %>
                    </select>
                </form>
                <form action="/sortby-mile" method="post" class="input-group mb-3 col">
                    <button type=" submit" class="btn btn-dark">Sort</button>
                    <select name="sortMile" class="form-select" id="inputGroupSelect01">
                        <option selected>Mile</option>
                        <option value="1">ASC</option>
                        <option value="2">DSC</option>
                    </select>
                </form>
            </div>

            <table class="table table-striped table-hover">
                <thead>
                    <tr>
                        <th scope="col">No</th>
                        <th scope="col">Make</th>
                        <th scope="col">Model</th>
                        <th scope="col">Price</th>
                        <th scope="col">Year</th>
                        <th scope="col">Fuel</th>
                        <th scope="col">Transmission</th>
                        <th scope="col">Mile</th>
                        <th scope="col">Color</th>
                        <th scope="col">Detail</th>
                    </tr>
                </thead>
                <tbody>


                    <% cars.forEach((car, index)=> {%>
                        <tr>
                            <th scope="row">
                                <%= index + 1 %>
                            </th>
                            <td>
                                <%= car.make %>
                            </td>
                            <td>
                                <%= car.model %>
                            </td>
                            <td>
                                <%= car.price %>
                            </td>
                            <td>
                                <%= car.year %>
                            </td>
                            <td>
                                <%= car.fuel %>
                            </td>
                            <td>
                                <%= car.transmission %>
                            </td>
                            <td>
                                <%= car.mile %>
                            </td>
                            <td>
                                <%= car.color %>
                            </td>
                            <td>
                                <a href="/edit-car/<%=car._id%>" class="btn btn-outline-dark">Edit</a>
                            </td>

                        </tr>
                        <% }) %>

                </tbody>
            </table>
        </div>
    </section>
</section>